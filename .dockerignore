# The Dockerfile runs `npm ci` and `poetry install` itself, so anything already
# installed or built locally must stay out of the context: it would be uploaded
# to the daemon on every build and, worse, `COPY frontend/ .` would overlay a
# host-built node_modules on top of the one npm ci just produced.
**/node_modules
frontend/.output
frontend/.nuxt
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Local state and secrets
**/*.db
**/*.sqlite3
**/kanchi.log
.env
**/.env.local

# Version control and tooling
.git
.github
**/.DS_Store

# Docs and deployment manifests are not needed to build the image
*.md
k8s-manifests
scripts
.gitignore
